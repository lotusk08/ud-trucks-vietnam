              </div>
            </div>
          </div>

          <!-- UD Trucks Thủ Đức -->
          <div class="dealer-item" data-filter="thủ đức thudc" data-id="thudc">
            <div class="dealer-location-icon">📍</div>
            <div class="dealer-info">
              <h4>UD Trucks Thủ Đức</h4>
              <p class="dealer-address">33 đường Quốc lộ 1A, Khu phố 1, Phường Hiệp Bình, TP HCM</p>
              <div class="dealer-contact">
                <a href="tel:+84" class="dealer-link">Call Now</a>
                <a href="#" class="dealer-link">Get Directions</a>
              </div>
            </div>
          </div>

          <!-- UD Trucks Bình Chánh -->
          <div class="dealer-item" data-filter="bình chánh binhchanh" data-id="binhchanh">
            <div class="dealer-location-icon">📍</div>
            <div class="dealer-info">
              <h4>UD Trucks Bình Chánh</h4>
              <p class="dealer-address">Quốc Lộ 1A, Xã Tân Nhựt, TP HCM</p>
              <div class="dealer-contact">
                <a href="tel:+84" class="dealer-link">Call Now</a>
                <a href="#" class="dealer-link">Get Directions</a>
              </div>
            </div>
          </div>

          <!-- UD Trucks Tiền Giang -->
          <div class="dealer-item" data-filter="tiền giang tiengiang" data-id="tiengiang">
            <div class="dealer-location-icon">📍</div>
            <div class="dealer-info">
              <h4>UD Trucks Tiền Giang</h4>
              <p class="dealer-address">Quốc Lộ 1A, Phường Nhị Quý, Đồng Tháp</p>
              <div class="dealer-contact">
                <a href="tel:+84" class="dealer-link">Call Now</a>
                <a href="#" class="dealer-link">Get Directions</a>
              </div>
            </div>
          </div>

          <!-- UD Trucks Cần Thơ -->
          <div class="dealer-item" data-filter="cần thơ cantho" data-id="cantho">
            <div class="dealer-location-icon">📍</div>
            <div class="dealer-info">
              <h4>UD Trucks Cần Thơ</h4>
              <p class="dealer-address">115 Quốc Lộ 1A, Phường Cái Răng, TP Cần Thơ</p>
              <div class="dealer-contact">
                <a href="tel:+84" class="dealer-link">Call Now</a>
                <a href="#" class="dealer-link">Get Directions</a>
              </div>
            </div>
          </div>

          <!-- UD Trucks Đà Nẵng -->
          <div class="dealer-item" data-filter="đà nẵng danang" data-id="danang">
            <div class="dealer-location-icon">📍</div>
            <div class="dealer-info">
              <h4>UD Trucks Đà Nẵng</h4>
              <p class="dealer-address">Quốc Lộ 1A, Thôn Phong Nam, Xã Hòa Xuân, TP Đà Nẵng</p>
              <div class="dealer-contact">
                <a href="tel:+84" class="dealer-link">Call Now</a>
