          <!-- Dealer markers -->
          <!-- Hanoi -->
          <circle class="dealer-marker" cx="90" cy="70" r="6" data-city="Hà Nội" data-id="hanoi"/>
          
          <!-- Bình Dương -->
          <circle class="dealer-marker" cx="110" cy="180" r="6" data-city="Bình Dương" data-id="binhdung"/>
          
          <!-- Thủ Đức -->
          <circle class="dealer-marker" cx="115" cy="200" r="6" data-city="Thủ Đức" data-id="thuduc"/>
          
          <!-- Bình Chánh -->
          <circle class="dealer-marker" cx="105" cy="210" r="6" data-city="Bình Chánh" data-id="binhchanh"/>
          
          <!-- Tiền Giang -->
          <circle class="dealer-marker" cx="100" cy="270" r="6" data-city="Tiền Giang" data-id="tiengiang"/>
          
          <!-- Cần Thơ -->
          <circle class="dealer-marker" cx="95" cy="350" r="6" data-city="Cần Thơ" data-id="cantho"/>
          
          <!-- Đà Nẵng -->
          <circle class="dealer-marker" cx="105" cy="120" r="6" data-city="Đà Nẵng" data-id="danang"/>
          
          <!-- Vũng Tàu -->
          <circle class="dealer-marker" cx="125" cy="240" r="6" data-city="Vũng Tàu" data-id="vungtau"/>
        </svg>
      </div>

      <div class="dealers-list">
