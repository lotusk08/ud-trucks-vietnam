              <p class="dealer-address">351 Quốc Lộ 51, KP. Mỹ Tân, P. Phú Mỹ, TP HCM</p>
              <div class="dealer-contact">
                <a href="tel:+84" class="dealer-link">Call Now</a>
                <a href="#" class="dealer-link">Get Directions</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const searchInput = document.getElementById('searchInput');
  const dealersItems = document.querySelectorAll('.dealer-item');
  const dealerMarkers = document.querySelectorAll('.dealer-marker');

  searchInput?.addEventListener('input', (e) => {
    const searchTerm = e.target.value.toLowerCase();

    dealersItems.forEach(item => {
      const filterText = item.getAttribute('data-filter');
      const matches = filterText.includes(searchTerm);
      item.style.display = matches ? 'flex' : 'none';
    });
  });

  // Marker interaction
  dealerMarkers.forEach(marker => {
    marker.addEventListener('click', () => {
      const dealerId = marker.getAttribute('data-id');
      const dealerItem = document.querySelector(`[data-id="${dealerId}"]`);
      if (dealerItem) {
        dealerItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        dealerItem.classList.add('highlight');
        setTimeout(() => dealerItem.classList.remove('highlight'), 2000);
      }
    });

    marker.addEventListener('mouseenter', () => {
      marker.style.r = '8';
    });

    marker.addEventListener('mouseleave', () => {
      marker.style.r = '6';
    });
  });

  // Highlight marker on hover
  dealersItems.forEach(item => {
    const dealerId = item.getAttribute('data-id');
    const marker = document.querySelector(`[data-id="${dealerId}"]`);

    item.addEventListener('mouseenter', () => {
      if (marker) {
        marker.style.r = '8';
        marker.style.filter = 'brightness(1.5)';
      }
      item.classList.add('active');
    });

    item.addEventListener('mouseleave', () => {
      if (marker) {
        marker.style.r = '6';
        marker.style.filter = 'brightness(1)';
      }
      item.classList.remove('active');
    });
  });
</script>

<style>
  .dealers-section {
    background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
    position: relative;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 1.5rem auto 0;
  }

  .dealers-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  .dealers-map-container {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vietnam-map {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 500px;
  }

  .dealer-marker {
    fill: var(--accent);
    stroke: var(--text-dark);
    stroke-width: 2;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dealer-marker:hover {
    filter: brightness(1.2);
  }

  .dealers-list {
    display: flex;
    flex-direction: column;
  }

  .dealers-list-header {
    margin-bottom: 2rem;
  }

  .dealers-list-header h3 {
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
    font-family: var(--font-serif);
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--input);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
  }

  .dealers-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 600px;
    overflow-y: auto;
    padding-right: 1rem;
  }

  .dealer-item {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .dealer-item:hover {
    border-color: var(--accent);
    background: rgba(45, 45, 45, 0.8);
  }

  .dealer-item.active {
    border-color: var(--accent);
    background: rgba(255, 107, 53, 0.1);
  }

  .dealer-item.highlight {
    animation: pulse 0.6s ease-out;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 107, 53, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(255, 107, 53, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 107, 53, 0);
    }
  }

  .dealer-location-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
  }

  .dealer-info {
    flex: 1;
  }

  .dealer-info h4 {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-family: var(--font-serif);
  }

  .dealer-address {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .dealer-contact {
    display: flex;
    gap: 1rem;
  }

  .dealer-link {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .dealer-link:hover {
    color: var(--accent-light);
  }

  /* Scrollbar styling */
  .dealers-items::-webkit-scrollbar {
    width: 6px;
  }

  .dealers-items::-webkit-scrollbar-track {
    background: transparent;
  }

  .dealers-items::-webkit-scrollbar-thumb {
    background: var(--accent);
    border-radius: 3px;
  }

  .dealers-items::-webkit-scrollbar-thumb:hover {
    background: var(--accent-light);
  }

  @media (max-width: 1024px) {
    .dealers-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .dealers-map-container {
      min-height: 350px;
    }
  }

  @media (max-width: 768px) {
    .dealers-section {
      padding: 4rem 0;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .dealers-content {
      gap: 1.5rem;
    }

    .dealers-items {
      max-height: 400px;
    }

    .dealer-item {
      padding: 1rem;
    }

    .dealer-info h4 {
      font-size: 1rem;
    }
  }
</style>
