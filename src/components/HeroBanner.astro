---
---

<section class="hero">
  <div class="hero-video">
    <img 
      src="/hero-banner.jpg" 
      alt="UD Trucks Vietnam - Heavy Duty Professional Trucks" 
      class="hero-image"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <div class="hero-text" data-animate>
      <p class="hero-subtitle">POWERFUL SOLUTIONS FOR VIETNAM</p>
      <h1 class="hero-title">Drive Success with UD Trucks</h1>
      <p class="hero-description">
        Experience superior reliability, efficiency, and performance. 
        Built for the demanding roads of Vietnam with world-class engineering.
      </p>
      
      <div class="hero-buttons">
        <a href="#trucks" class="btn btn-primary">Explore Trucks</a>
        <a href="#contact" class="btn btn-secondary">Learn More</a>
      </div>
    </div>
  </div>

  <div class="hero-scroll-indicator">
    <span>Scroll to explore</span>
    <div class="scroll-icon">
      <div class="scroll-wheel"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    margin-top: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(15, 15, 15, 0.8) 0%,
      rgba(26, 26, 26, 0.6) 50%,
      rgba(15, 15, 15, 0.8) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: left;
    max-width: 800px;
    padding: 0 2rem;
  }

  .hero-text {
    animation: fadeInUp 1s ease-out;
  }

  .hero-subtitle {
    font-size: 0.9rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: 4.5rem;
    line-height: 1;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    font-family: var(--font-serif);
    font-weight: 700;
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 500px;
  }

  .hero-buttons {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: bounce 2s infinite;
  }

  .hero-scroll-indicator span {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .scroll-icon {
    width: 24px;
    height: 40px;
    border: 2px solid var(--accent);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .scroll-wheel {
    width: 3px;
    height: 8px;
    background: var(--accent);
    border-radius: 2px;
    animation: scroll 1.5s infinite;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(-10px);
    }
  }

  @keyframes scroll {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (max-width: 768px) {
    .hero {
      height: 70vh;
      margin-top: 60px;
    }

    .hero-content {
      padding: 0 1.5rem;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-description {
      font-size: 1rem;
    }

    .hero-buttons {
      flex-direction: column;
      gap: 1rem;
    }

    .hero-scroll-indicator {
      display: none;
    }
  }
</style>
