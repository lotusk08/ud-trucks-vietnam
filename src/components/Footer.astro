      <div class="showrooms-grid">
        <div class="showroom-item">
          <strong>Hà Nội</strong>
          <p>Thôn Trai Túc, Xã Như Quỳnh, Hưng Yên</p>
        </div>
        <div class="showroom-item">
          <strong>Bình Dương</strong>
          <p>39A/11 Quốc lộ 1A, KP Ngãi Thắng, Phường Đông Hòa</p>
        </div>
        <div class="showroom-item">
          <strong>Thủ Đức</strong>
          <p>33 đường Quốc lộ 1A, Khu phố 1, Phường Hiệp Bình</p>
        </div>
        <div class="showroom-item">
          <strong>Bình Chánh</strong>
          <p>Quốc Lộ 1A, Xã Tân Nhựt</p>
        </div>
        <div class="showroom-item">
          <strong>Tiền Giang</strong>
          <p>Quốc Lộ 1A, Phường Nhị Quý, Đồng Tháp</p>
        </div>
        <div class="showroom-item">
          <strong>Cần Thơ</strong>
          <p>115 Quốc Lộ 1A, Phường Cái Răng</p>
        </div>
        <div class="showroom-item">
          <strong>Đà Nẵng</strong>
          <p>Quốc Lộ 1A, Thôn Phong Nam, Xã Hòa Xuân</p>
        </div>
        <div class="showroom-item">
          <strong>Vũng Tàu</strong>
