          <p class="footer-tagline">Official Distributor for Vietnam Market</p>
          <p class="footer-corporate">By Nam Han Group</p>
        </div>
        <p class="footer-description">
          Delivering world-class truck solutions to Vietnam's transportation and logistics industries.
        </p>
      </div>

      <!-- Products -->
      <div class="footer-section">
        <h4>Trucks</h4>
        <ul>
          <li><a href="#trucks">Quester - Heavy Duty</a></li>
          <li><a href="#trucks">Croner - Medium Duty</a></li>
          <li><a href="#trucks">Condor - Light Duty</a></li>
          <li><a href="#trucks">Specifications</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div class="footer-section">
        <h4>Services</h4>
        <ul>
          <li><a href="#services">Sales</a></li>
          <li><a href="#services">Service & Support</a></li>
          <li><a href="#services">Fleet Management</a></li>
          <li><a href="#services">Financing</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div class="footer-section">
        <h4>Company</h4>
        <ul>
          <li><a href="#about">About UD Trucks</a></li>
          <li><a href="#stories">News & Stories</a></li>
          <li><a href="#dealers">Find a Dealer</a></li>
          <li><a href="#contact">Contact Us</a></li>
        </ul>
