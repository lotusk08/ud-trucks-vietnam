    <!-- Bottom -->
    <div class="footer-bottom">
      <div class="footer-legal">
        <p>&copy; 2024 UD Trucks Vietnam. All rights reserved. Operated by Nam Han Group.</p>
      </div>
      <div class="footer-links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
        <a href="#">Cookie Policy</a>
        <a href="#">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    margin-top: 4rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    padding: 3rem 0;
    border-bottom: 1px solid rgba(255, 107, 53, 0.1);
  }

  .footer-section h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-section ul {
    list-style: none;
  }

  .footer-section ul li {
    margin-bottom: 0.75rem;
  }

  .footer-section a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    transition: all 0.3s ease;
  }

  .footer-section a:hover {
    color: var(--accent);
  }

  .footer-brand {
    grid-column: span 1;
  }

  .footer-logo h3 {
    font-size: 1.2rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    font-family: var(--font-serif);
    letter-spacing: 0.05em;
  }

  .footer-tagline {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .footer-corporate {
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .footer-description {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .footer-showrooms {
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255, 107, 53, 0.1);
  }

  .footer-showrooms h4 {
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .showrooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .showroom-item {
    background: rgba(45, 45, 45, 0.3);
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid rgba(255, 107, 53, 0.05);
    transition: all 0.3s ease;
  }

  .showroom-item:hover {
    border-color: var(--accent);
    background: rgba(45, 45, 45, 0.5);
  }

  .showroom-item strong {
    display: block;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .showroom-item p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .footer-bottom {
    padding: 2rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-legal p {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 1024px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .footer {
      padding: 2rem 0;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem 0;
    }

    .footer-brand {
      grid-column: span 1;
    }

    .footer-section h4 {
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }

    .footer-section ul li {
      margin-bottom: 0.5rem;
    }

    .showrooms-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem 0;
    }

    .footer-links {
      gap: 1rem;
    }
  }
</style>
